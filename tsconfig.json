{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist"
  },
  // The tests are typechecked so `@ts-expect-error` guards (no per-button class
  // key) are enforced. packaging.test.ts reads package.json through node:fs,
  // and this repo carries no Node types, so it is the one file left out.
  "include": ["src", "tests"],
  "exclude": ["tests/packaging.test.ts"]
}
